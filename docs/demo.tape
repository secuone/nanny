# Record the README GIF with https://github.com/charmbracelet/vhs : vhs docs/demo.tape
Output docs/demo.gif
Set Shell "bash"
Set FontSize 15
Set Width 1400
Set Height 820
Set Padding 16
Set Framerate 6
Set Theme { "name": "nanny", "black": "#14151f", "red": "#ff6b81", "green": "#7ee0a1", "yellow": "#f5c76b", "blue": "#6cb6ff", "magenta": "#a78bfa", "cyan": "#5eead4", "white": "#b4b9d0", "brightBlack": "#7d83a2", "brightRed": "#ff6b81", "brightGreen": "#7ee0a1", "brightYellow": "#f5c76b", "brightBlue": "#6cb6ff", "brightMagenta": "#f472b6", "brightCyan": "#5eead4", "brightWhite": "#e6e8f2", "background": "#14151f", "foreground": "#e6e8f2", "selection": "#3b3f5c", "cursor": "#a78bfa" }
Set TypingSpeed 60ms
Env NANNY_NO_WELCOME "1"
Hide
Type "clear" Enter
Type "nanny demo" Enter
Sleep 3s
Type "7" Sleep 500ms
Right Sleep 500ms
Type "1" Sleep 500ms
Show
Sleep 2s
Down Sleep 800ms Down Sleep 800ms Down Sleep 1.2s
Type "2" Sleep 1.2s
Type "/redis" Sleep 1.8s
Escape Escape Sleep 500ms
Type "7" Sleep 2.5s
Ctrl+K Sleep 500ms
Type "theme" Sleep 1.5s
Escape Sleep 300ms
Type "1" Sleep 2s
